{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info, warnings_as_errors]}.
%% the acceptance tests (acceptance/README.md) are compiled with the application but are not part of it
{extra_src_dirs, ["acceptance"]}.
%% PQCF (L1): its task behaviour and executors (pq_task, pq_rexec), pinned to a commit
{deps, [{pq, {git, "https://github.com/quanterall/pqcf.git", {ref, "2a90a1fffbc4876f35b69a24342d294eb590f27b"}}}]}.
{pre_hooks, [{compile, "sh native/build.sh"}]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling]}, {plt_extra_apps, [inets, ssl, public_key, mnesia, pq]}]}.
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls,
               deprecated_functions]}.
