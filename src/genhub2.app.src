{application, genhub2, [
    {description, "GenHub2: rapid classification of DNA and RNA viruses, the first application on PQCF"},
    {vsn, "0.1.0"},
    {registered, [gh_sup, gh_jobs]},
    {mod, {gh_app, []}},
    {applications, [kernel, stdlib, crypto, public_key, inets, ssl, mnesia, pq, cowboy, emqtt]},
    {env, [{data_dir, "data"},
           %% the gateway: address and port (phase A: this machine only; accounts and MFA come with sharing)
           {http, #{ip => {127, 0, 0, 1}, port => 8480}},
           %% the site's EMQX broker (undefined: no MQTT; the services still talk through gh_events)
           {mqtt, undefined},
           %% site: the site's services; worker: one of the lab's further nodes, running tasks only (gh_app)
           {role, site},
           %% the executor of the steps that may leave this node (gh_jobs): local, {nodes, [Node]}, or federation
           {executor, local},
           %% the FVLLMP node GenHub2 runs on, for the federation executor (gh_fed): its address, the file holding
           %% GenHub2's token there (kept outside the repository, mode 600), the genhub2-task image by digest, and
           %% the tasks GenHub2 may run there at once; undefined: no federation
           {federation, undefined},
           %% the task types this node runs for PQCF's executors (pq_task's allow-list)
           {task_modules, [gh_validate, gh_dehost, gh_screen, gh_consensus, gh_classify, gh_protein, gh_mutations, gh_lineage,
                           gh_tree, gh_phylo, gh_usher, gh_kraken, gh_knowledge, gh_fetch]}]},
    {licenses, ["Apache-2.0"]}
]}.
